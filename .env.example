# Copy to .env for local builds. In GitHub, set these as repository Variables
# (Settings > Secrets and variables > Actions > Variables).
SITE_NAME=
# e.g. https://phtrendwatch.world (enables canonical links, sitemap.xml and robots.txt)
SITE_URL=
# Shown on the Contact and Privacy pages. AdSense expects a way to reach you.
CONTACT_EMAIL=
# Show an in-feed ad after every N headlines (minimum 2, default 6).
AD_EVERY=
# From your AdSense account. Leave blank to show ad placeholders.
ADSENSE_CLIENT=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_INFEED=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_BOTTOM=
