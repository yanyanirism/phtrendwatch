# Copy to .env for local builds. In GitHub, set these as repository Variables
# (Settings > Secrets and variables > Actions > Variables).
SITE_NAME=
# e.g. https://phtrendwatch.world (enables canonical links, sitemap.xml and robots.txt)
SITE_URL=
# Shown on the Contact and Privacy pages. AdSense expects a way to reach you.
CONTACT_EMAIL=
# Calculators site linked from the header, footer and guides (default https://tools.phtrendwatch.world).
TOOLS_URL=
# Optional search engine verification codes (the content value of each meta tag), and an IndexNow key
# (any 8-128 letters/digits; it is public and served at /<key>.txt) to notify Bing and others after a push.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
# Google Analytics 4 measurement ID (G-...). Adds the tracking tag and an Analytics section to the privacy policy.
GA_MEASUREMENT_ID=
# Show an in-feed ad after every N headlines (minimum 2, default 6).
AD_EVERY=
# From your AdSense account. Leave blank to show ad placeholders.
ADSENSE_CLIENT=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_INFEED=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_BOTTOM=
